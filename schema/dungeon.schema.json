    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Seed",
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    }
  },
  "required": [
    "generator",
    "seed",
    "repo",
    "floors",
    "totals"
  ],
  "title": "DungeonSpec",
  "type": "object"
